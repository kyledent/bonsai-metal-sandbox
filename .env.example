# Copied to .env by ./bonsai on first run. .env is git-ignored. Values are literal (no quotes, no $VARS), and a
# variable already set in your shell wins.

# The model: 2B (0.5 GB), 9B (2.4 GB) or 27B (7.2 GB). ./bonsai models lists them.
BONSAI_MODEL=27B

# PQ2_0 (the pack Prism measures on Apple Silicon) or PTQ1_0 (about 17% smaller; where memory is tightest)
BONSAI_QUANT=PQ2_0

# Where the GGUF files go. The server's sandbox can read this folder and nothing else of yours.
BONSAI_MODEL_DIR=./models

# 1: also download the vision file (0.4-0.6 GB) and accept images
BONSAI_VISION=0

# Context in tokens. Empty: by RAM, as Bonsai-demo does (up to 11 GB 8K, up to 23 GB 16K, up to 35 GB 32K, up to 71 GB
# 64K, more 128K on the 27B and 64K on the others). About 64 KiB of memory per token on the 27B, on top of the weights.
# The models' limit is 262144.
BONSAI_CTX=

# Ports the agent may reach and detection tries. The server listens on the first (on loopback only).
BONSAI_PORTS=8080-8083

# Thinking budget (tokens) of requests that do not set one, such as pi's compaction summaries. Empty: a sixteenth of the
# context, which leaves room for the summary.
BONSAI_REASONING_BUDGET=

# Prompt cache cap in MiB. Empty: a quarter of the RAM, at most 24576.
BONSAI_CACHE_RAM=

# More llama-server arguments, split on spaces
BONSAI_SERVER_ARGS=

# The server's api_key, if you want one. Leave empty for none. pi's agent can read it.
BONSAI_API_KEY=

# What the agent's sandbox can connect to:
#   server    only BONSAI_PORTS on loopback (the default)
#   loopback  any port on loopback, and it may listen there; for dev servers. This reaches every local service.
#   open      the internet too; for npm, pip and git remotes. The agent can then send out whatever it can read.
BONSAI_AGENT_NETWORK=server

# Thinking: 1 offers it in pi (levels off, low, medium, high, xhigh; default high), 0 turns it off.
BONSAI_THINKING=1

# Each pi level's effort (xhigh or medium; only the 27B has efforts) and thinking budget, as level=effort:budget. Empty:
# low=medium:2048,medium=medium:4096,high=xhigh:8192,xhigh=xhigh:16384. List only the levels you change.
BONSAI_THINKING_LEVELS=

# Largest max output (tokens) to give pi. Empty: 24576 with thinking, 8192 without. Also capped at a quarter of the
# context.
BONSAI_MAX_OUTPUT=

# GitHub token for gh and git in the sandbox. pi's agent can read it, so use a narrow fine-grained token. It only helps
# with BONSAI_AGENT_NETWORK=open. Leave empty for none.
GH_TOKEN=

# Folder that the agent works on
WORKSPACE_DIR=./workspace

# pi release (npm @mariozechner/pi-coding-agent). Change and run ./bonsai setup to upgrade.
PI_VERSION=0.73.1
